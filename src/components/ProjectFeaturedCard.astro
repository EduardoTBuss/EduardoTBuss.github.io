---
/** Panoramic case study. Claims originate in the validated content layer. */
import type { Project } from "../lib/schemas";
import { projectHref } from "../lib/content";
import ProjectVisual from "./ProjectVisual.astro";
interface Props {
  project: Project;
  mediaType?: "physics" | "nbody" | "quantum" | "qfie" | "neuroevolution" | "raytracer" | "generic";
  mediaLabel?: string;
}
const visualBySlug: Record<string, NonNullable<Props['mediaType']>> = {
  'q-fie': 'qfie',
  'neuroevolution-sim': 'neuroevolution',
  'ray-tracer': 'raytracer',
  'physics2d': 'physics',
  'nbody-sim': 'nbody',
  'quantum-algorithms-qiskit': 'quantum',
};
const {
  project,
  mediaType = visualBySlug[Astro.props.project.slug] ?? 'generic',
} = Astro.props;
const href = projectHref(project);
---

<article class="tech-card featured-project-card">
  <ProjectVisual kind={mediaType} />
  <div class="content-body">
    <div class="meta">
      <span>{project.category}</span><span>{project.year}</span>
    </div>
    <h3>{project.title}</h3>
    <p class="tagline">{project.tagline}</p>
    {
      project.headline_metric && (
        <div class="evidence">
          <>
            <span>From the project</span>
            <p>{project.headline_metric}</p>
          </>
        </div>
      )
    }
    <div class="languages">
      {project.languages.map((language) => <span>{language}</span>)}
    </div>
    <div class="actions">
      {
        href && (
          <a
            class="primary"
            href={href}
            aria-label={`Explore ${project.title} case study`}
          >
            Explore case study ↗
          </a>
        )
      }<a
        href={project.links.repo}
        aria-label={`${project.title} source code on GitHub`}>Source code ↗</a>
    </div>
  </div>
</article>
<style>
  .featured-project-card {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    min-height: 570px;
    height: 100%;
    background:
      radial-gradient(
        500px circle at var(--spot-x, 50%) var(--spot-y, 50%),
        var(--accent-glow),
        transparent 70%
      ),
      var(--bg-elevated);
    border: 1px solid var(--rule);
    border-radius: 24px;
    overflow: hidden;
  }
  .content-body {
    padding: clamp(26px, 4vw, 50px);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--accent);
    font: 10px var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  h3 {
    font-size: clamp(25px, 3vw, 39px);
    line-height: 1.1;
    letter-spacing: -0.045em;
    margin: 28px 0 18px;
    overflow-wrap: anywhere;
    color: var(--fg);
  }
  .tagline {
    font-size: 17px;
    line-height: 1.55;
    color: var(--fg);
    margin: 0 0 16px;
  }
  .evidence {
    padding: 15px 0;
    border-block: 1px solid var(--rule);
  }
  .evidence > span {
    font: 10px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-dim);
  }
  .evidence p {
    font: 12px/1.7 var(--font-mono);
    color: var(--accent);
    margin: 8px 0 0;
  }
  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 26px;
  }
  .languages span {
    font: 10px var(--font-mono);
    color: var(--fg-muted);
    border: 1px solid var(--rule);
    border-radius: 30px;
    padding: 5px 10px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    margin-top: auto;
    font-size: 14px;
  }
  .actions a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--fg-muted);
  }
  .actions .primary {
    background: var(--accent);
    color: var(--bg);
    padding: 0 22px;
    border-radius: 8px;
    font-weight: 600;
  }
  .actions a:hover {
    filter: brightness(1.15);
  }
  @media (max-width: 760px) {
    .featured-project-card {
      grid-template-columns: 1fr;
      min-height: 0;
      border-radius: 18px;
    }
    .content-body {
      padding: 26px;
    }
    h3 {
      margin-top: 22px;
    }
  }
</style>

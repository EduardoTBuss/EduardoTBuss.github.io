---
/** Opening statement: who, what, and three direct paths into the work. */
import BlochSphere from "../BlochSphere.astro";
---

<header class="hero">
  <p class="eyebrow">
    <span aria-hidden="true"></span> AI ENGINEERING · MACHINE LEARNING · RESEARCH
  </p>
  <h1>Eduardo<br />Timm Buss<span class="name-period">.</span></h1>
  <div class="hero-sphere" aria-hidden="true">
    <BlochSphere id="hero-bloch" animated />
  </div>
  <p class="hero-statement">
    From models to <em>reliable AI systems.</em>
  </p>
  <p class="hero-context">
    I build and evaluate AI systems and study quantum-fuzzy methods at UFPel.
  </p>
  <div class="hero-actions">
    <a class="button-primary" href="#work">See projects ↓</a><a
      class="button-secondary"
      href="/publications/">Publications</a
    ><a class="button-secondary" href="/cv/">CV</a>
  </div>
</header>
<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    grid-template-areas:
      "eyebrow eyebrow"
      "name sphere"
      "statement sphere"
      "context sphere"
      "actions sphere";
    grid-template-rows: auto auto auto auto 1fr;
    column-gap: var(--s5);
    padding-block: var(--s7) var(--s6);
  }
  .eyebrow {
    grid-area: eyebrow;
    display: flex;
    align-items: center;
    gap: var(--s3);
    font: 0.78rem var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: var(--s5);
  }
  .eyebrow span {
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 16px var(--accent);
  }
  h1 {
    grid-area: name;
    font-size: clamp(3.9rem, 6.4vw, 6.6rem);
    line-height: 0.92;
    letter-spacing: -0.075em;
    font-weight: 600;
  }
  .name-period {
    color: var(--accent);
  }
  .hero-sphere {
    grid-area: sphere;
    align-self: center;
    justify-self: center;
    width: min(100%, 330px);
    margin-top: calc(-1 * var(--s5));
  }
  .hero-statement {
    grid-area: statement;
    max-width: 30rem;
    margin-top: var(--s5);
    color: var(--fg);
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.035em;
  }
  .hero-context {
    grid-area: context;
    max-width: 30rem;
    margin-top: var(--s3);
    color: var(--fg-muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }
  em {
    color: var(--accent);
    font-style: normal;
  }
  .hero-actions {
    grid-area: actions;
    display: flex;
    gap: var(--s3);
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--s6);
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(72px, 24vw);
      grid-template-areas:
        "eyebrow eyebrow"
        "name sphere"
        "statement statement"
        "context context"
        "actions actions";
      grid-template-rows: auto;
      column-gap: var(--s2);
      padding-block: var(--s5) var(--s3);
    }
    .eyebrow {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      margin-bottom: var(--s4);
    }
    h1 {
      font-size: clamp(2.6rem, 11.5vw, 4.6rem);
    }
    .hero-sphere {
      width: 100%;
      margin: 0;
    }
    .hero-statement {
      margin-top: var(--s4);
    }
    .hero-actions {
      margin-top: var(--s5);
      gap: var(--s2);
    }
    .hero-actions a {
      flex: 1 1 auto;
      padding-inline: 14px;
      gap: var(--s2);
    }
  }
  @media (max-width: 380px) {
    .hero-context {
      font-size: 0.98rem;
    }
    .hero-actions {
      margin-top: var(--s4);
      gap: 6px;
    }
    .hero-actions a {
      min-height: 48px;
      padding: 10px;
      font-size: 0.88rem;
    }
  }
</style>

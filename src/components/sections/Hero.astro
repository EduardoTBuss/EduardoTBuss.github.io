---
import { getProfile } from "../../lib/content";
const p = getProfile();
---

<header class="hero">
  <div class="hero-copy">
    <p class="eyebrow"><span aria-hidden="true"></span> COMPUTER ENGINEERING & RESEARCH</p>
    <h1>Eduardo<br />Timm Buss<span class="name-period">.</span></h1>
    <p class="hero-statement">
      From abstract ideas to <em>working systems.</em>
    </p>
    <div class="hero-actions">
      <a class="button-primary" href="#explore">Explore research projects ↗</a><a
        class="button-text"
        href="/publications/">Read publications ↗</a>
    </div>
  </div>
</header>
<div class="hero-bottom">
  <span>UFPEL / BRAZIL</span><a href="#explore">SCROLL TO EXPLORE ↓</a><a
    href={p.links.github}>GITHUB ↗</a>
</div>
<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 560px;
    padding-block: var(--s7);
    isolation: isolate;
    overflow: clip;
  }
  .hero::after {
    content: "";
    position: absolute;
    right: -12%;
    top: 4%;
    width: min(54vw, 650px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(58, 128, 183, 0.12), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--s3);
    font: 0.72rem var(--font-mono);
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: var(--s6);
  }
  .eyebrow span {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 16px var(--accent);
  }
  h1 {
    max-width: 11ch;
    font-size: clamp(4.25rem, 7.5vw, 7.25rem);
    line-height: 0.92;
    letter-spacing: -0.08em;
    font-weight: 600;
  }
  .name-period {
    color: var(--accent);
  }
  .hero-statement {
    max-width: 38rem;
    margin-top: var(--s6);
    color: var(--fg-muted);
    font-size: clamp(1.4rem, 2.5vw, 2.25rem);
    line-height: 1.32;
    letter-spacing: -0.04em;
  }
  em {
    color: var(--accent);
    font-style: normal;
  }
  .hero-actions {
    display: flex;
    gap: var(--s5);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--s6);
  }
  .hero-bottom {
    border-block: 1px solid var(--rule);
    padding-block: var(--s5);
    display: flex;
    justify-content: space-between;
    gap: var(--s4);
    font: 0.68rem var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--fg-muted);
  }
  .hero-bottom a {
    color: var(--fg-muted);
  }
  @media (max-width: 760px) {
    .hero {
      min-height: 650px;
      padding-block: var(--s8);
    }
    h1 {
      font-size: clamp(3.8rem, 12.8vw, 6.5rem);
    }
    .eyebrow {
      margin-bottom: var(--s6);
    }
    .hero-statement {
      margin-top: var(--s6);
    }
    .hero-actions {
      gap: var(--s3) var(--s5);
      margin-top: var(--s6);
    }
    .hero-bottom > span {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .hero {
      min-height: 570px;
    }
    h1 {
      font-size: clamp(3.2rem, 12.5vw, 4.2rem);
    }
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }
    .hero-actions .button-primary {
      width: 100%;
      justify-content: space-between;
    }
    .hero-actions .button-text {
      width: fit-content;
    }
  }
</style>

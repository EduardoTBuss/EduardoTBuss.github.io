---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Metrics from '../../components/Metrics.astro';
import { getProject, getPublicationsFor } from '../../lib/content';

export async function getStaticPaths() {
  const pages = await getCollection('projects');
  return pages.map((page) => ({ params: { slug: page.data.project }, props: { page } }));
}

const { page } = Astro.props;
const project = getProject(page.data.project);
if (!project) {
  throw new Error(
    `src/content/projects/${page.id}.md points at "${page.data.project}", ` +
    `which does not exist in projects.json`
  );
}
const publications = getPublicationsFor(project.publications);
const { Content } = await render(page);
---
<Base
  title={`${project.title} — ${Astro.site ? 'Eduardo Timm Buss' : ''}`.trim()}
  description={project.summary}
>
  <article>
    <p class="back"><a href="/#work">Selected work</a></p>

    <h1>{project.title}</h1>
    <p class="tagline">{project.tagline}</p>
    <p class="meta">
      {project.category} &middot; {project.languages.join(', ')} &middot; {project.year}
    </p>

    <section aria-labelledby="metrics-heading" class="metrics">
      <h2 id="metrics-heading">Measured</h2>
      <Metrics metrics={page.data.metrics} />
    </section>

    <div class="prose"><Content /></div>

    <section aria-labelledby="resources-heading">
      <h2 id="resources-heading">Resources</h2>
      <ul>
        <li><a href={project.links.repo} rel="noopener">Repository on GitHub</a></li>
        {project.links.demo && <li><a href={project.links.demo} rel="noopener">Live demo</a></li>}
        {project.links.docs && <li><a href={project.links.docs} rel="noopener">Documentation</a></li>}
        {project.links.dataset && <li><a href={project.links.dataset} rel="noopener">Data source</a></li>}
        {publications.map((p) => (
          <li>
            {p.doi
              ? <a href={`https://doi.org/${p.doi}`} rel="noopener">{p.title}</a>
              : p.url
                ? <a href={p.url} rel="noopener">{p.title}</a>
                : <span>{p.title}</span>}
            <span class="muted"> &mdash; {p.venue}, {p.year}</span>
          </li>
        ))}
      </ul>
    </section>

    <p class="meta updated">Page updated {page.data.updated}</p>
  </article>
</Base>

<style>
  article { padding-top: var(--s7); }
  .back { font-size: var(--fs-sm); margin-bottom: var(--s5); }
  h1 { margin-top: 0; }
  .tagline { margin-top: var(--s3); color: var(--fg-muted); }
  .meta { margin-top: var(--s3); }
  .metrics { margin-top: var(--space-section); }
  .metrics h2 { margin-bottom: var(--space-heading); }
  .prose :global(h2) {
    margin-top: var(--space-section);
    margin-bottom: var(--space-heading);
  }
  .prose :global(p) { margin-bottom: var(--space-paragraph); }
  section { margin-top: var(--space-section); }
  section h2 { margin-bottom: var(--space-heading); }
  ul { padding-left: var(--s5); }
  li { margin-top: var(--s2); }
  .updated { margin-top: var(--space-section); }
</style>

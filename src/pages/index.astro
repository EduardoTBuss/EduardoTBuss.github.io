---
/** Overview composition. Detailed records remain on their dedicated routes. */
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import HorizontalProjectDeck from "../components/HorizontalProjectDeck.astro";
import PublicationCard from "../components/PublicationCard.astro";
import ResearchOverview from "../components/sections/ResearchOverview.astro";
import Contact from "../components/sections/Contact.astro";
import {
  getProfile,
  getPortfolioWork,
  getFeaturedWork,
  getPublications,
  vqcDepthStudy,
} from "../lib/content";
const p = getProfile();
const projects = getPortfolioWork();
const featured = getFeaturedWork();
const publications = getPublications();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: p.name,
  jobTitle: p.subtitle,
  description: p.bio,
  url: Astro.site?.href,
  sameAs: [p.links.github, p.links.linkedin, p.links.orcid, p.links.scholar].filter(Boolean),
};
---

<Base
  title={`${p.name} | AI Engineering, Machine Learning & Research`}
  description={p.bio}
  jsonLd={jsonLd}
>
  <div class="landing-grid">
    <div class="hero-column"><Hero /></div>
    <nav class="quick-paths" aria-label="Featured engineering and research">
      <a href="/projects/order-forge/">
        <span class="quick-label">Applied AI</span>
        <strong>Order Forge</strong>
        <span>PDF orders to validated EDIFACT with human review.</span>
        <small>See the workflow and benchmark ↗</small>
      </a>
      <a href={vqcDepthStudy.href}>
        <span class="quick-label">Published research · ERAMIA-RS 2026</span>
        <strong>Does more circuit depth help?</strong>
        <span>A second quantum circuit layer improved test F1 on three datasets.</span>
        <small>See the results and classical baseline ↗</small>
      </a>
    </nav>
  </div>
  <section class="overview-section" id="explore" aria-labelledby="work-heading">
    <div class="section-heading">
      <div>
        <span class="section-kicker">01 / SELECTED WORK</span><h2
          id="work-heading"
        >
          Applied AI, research and systems.
        </h2>
      </div><a href="/projects/">Explore all {projects.length} projects ↗</a>
    </div>
    <HorizontalProjectDeck projects={featured} />
  </section>
  <ResearchOverview />
  <section class="overview-section" aria-labelledby="papers-heading">
    <div class="section-heading">
      <div>
        <span class="section-kicker">03 / PUBLICATIONS</span><h2
          id="papers-heading"
        >
          Research with published results.
        </h2>
      </div><a href="/publications/"
        >All {publications.length} publications ↗</a>
    </div>
    <div class="publication-grid">
      {
        publications
          .slice(0, 2)
          .map((publication) => <PublicationCard publication={publication} />)
      }
    </div>
  </section>
  <Contact />
</Base>
<style>
  .landing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(310px, 0.8fr);
    gap: clamp(var(--s5), 4vw, var(--s8));
    align-items: center;
    border-bottom: 1px solid var(--rule);
  }
  .hero-column {
    min-width: 0;
  }
  .quick-paths {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s4);
  }
  .quick-paths a {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    padding: var(--s5);
    color: var(--fg);
    background: var(--bg-surface);
    border: 1px solid var(--rule-bright);
    border-radius: var(--radius-lg);
  }
  .quick-paths a:hover {
    text-decoration: none;
    border-color: var(--accent);
    background: var(--bg-elevated);
  }
  .quick-paths strong {
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
    letter-spacing: -0.04em;
    line-height: 1.15;
  }
  .quick-paths span {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  .quick-paths .quick-label {
    font: 0.73rem var(--font-mono);
    color: var(--accent);
  }
  .quick-paths small {
    margin-top: var(--s1);
    color: var(--accent);
    font-size: 0.78rem;
  }
  .overview-section {
    margin-block: var(--space-section);
  }
  .publication-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s5);
  }
  @media (max-width: 760px) {
    .landing-grid {
      grid-template-columns: 1fr;
      gap: var(--s3);
      padding-bottom: var(--s6);
    }
    .quick-paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s3);
    }
    .quick-paths a {
      padding: var(--s3);
    }
    .quick-paths strong {
      font-size: clamp(1.07rem, 4vw, 1.3rem);
    }
    .quick-paths span {
      font-size: 0.83rem;
      line-height: 1.4;
    }
    .quick-paths small {
      margin-top: auto;
    }
    .publication-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

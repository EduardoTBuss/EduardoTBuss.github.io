---
import { getProfile } from "../../lib/content";
const p = getProfile();
---

<section class="contact-section" id="contact" aria-labelledby="contact-heading">
  <div>
    <span class="section-kicker">04 / OPEN A CONVERSATION</span><h2
      id="contact-heading"
    >
      Good ideas start<br />with <em>a conversation.</em>
    </h2><p>
      AI and ML engineering opportunities, research collaborations, or a question
      about the systems and experiments shown here.
    </p>
  </div>
  <div class="contact-actions">
    <a class="button-primary" href={p.links.academic_email}>Get in touch ↗</a><a
      class="email"
      href={p.links.academic_email}
      >{p.links.academic_email.replace("mailto:", "")}</a
    ><nav aria-label="Academic and social profiles">
      <a href={p.links.github}>GitHub ↗</a><a href={p.links.linkedin}
        >LinkedIn ↗</a
      ><a href={p.links.orcid}>ORCID ↗</a>
    </nav>
  </div>
</section>
<style>
  .contact-section {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--s7);
    padding: var(--s8) 0;
    border-top: 1px solid var(--rule);
    margin-top: var(--space-section);
  }
  h2 {
    font-size: clamp(2.5rem, 4vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.15;
  }
  em {
    font-style: normal;
    color: var(--accent);
  }
  p {
    font-size: 0.85rem;
    color: var(--fg-muted);
    max-width: 27rem;
    margin-top: var(--s5);
  }
  .contact-actions {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    flex-direction: column;
    gap: var(--s5);
  }
  .email {
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  nav {
    display: flex;
    gap: var(--s5);
    font: 0.65rem var(--font-mono);
  }
  nav a {
    color: var(--fg-muted);
  }
  @media (max-width: 760px) {
    .contact-section {
      grid-template-columns: 1fr;
    }
  }
</style>

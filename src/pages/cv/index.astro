---
/**
 * Dedicated Curriculum Vitae & Technical Stack page (/cv/).
 */
import Base from '../../layouts/Base.astro';
import Cv from '../../components/sections/Cv.astro';
import TechMatrix from '../../components/sections/TechMatrix.astro';
import Now from '../../components/sections/Now.astro';
import { getProfile } from '../../lib/content';

const profile = getProfile();
---

<Base
  title={`Curriculum Vitae & Stack — ${profile.name}`}
  description="Academic background, FAPERGS fellowship, research experience and technical stack of Eduardo Timm Buss."
>
  <div class="page-container reveal-up">
    <header class="page-header">
      <span class="mono-tag page-eyebrow">// TRAJECTORY & ENGINEERING TOOLING</span>
      <h1>Background & tools.</h1>
      <p class="page-desc">
        Computer Engineering at UFPel. Research across quantum computing, fuzzy systems
        and machine learning.
      </p>
    </header>

    <div class="cv-section scroll-reveal">
      <Cv />
    </div>

    <div class="matrix-section scroll-reveal" style="margin-top: var(--space-section);">
      <TechMatrix />
    </div>

    <div class="now-section scroll-reveal" style="margin-top: var(--space-section);">
      <Now />
    </div>
  </div>
</Base>

<style>
  .page-container {
    padding-top: var(--s7);
    padding-bottom: var(--s8);
  }

  .page-header {
    margin-bottom: var(--s7);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--s6);
  }

  .page-eyebrow {
    color: var(--accent);
    margin-bottom: var(--s3);
  }

  h1 {
    font-size: var(--fs-2xl);
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: var(--s2) 0 var(--s3) 0;
  }

  .page-desc {
    font-size: var(--fs-base);
    color: var(--fg-muted);
    max-width: 42rem;
    line-height: var(--lh-body);
    margin: 0;
  }
</style>

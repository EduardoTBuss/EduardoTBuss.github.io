---
/**
 * Selected work with applied AI, research and systems featured first.
 */
import Section from '../Section.astro';
import HorizontalProjectDeck from '../HorizontalProjectDeck.astro';
import { getPortfolioWork, getFeaturedWork, getProfile } from '../../lib/content';

const projects = getPortfolioWork();
const profile = getProfile();

const featuredProjects = getFeaturedWork();
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));
const caseStudies = projects.filter((project) => project.has_page && !featuredSlugs.has(project.slug));
const repositoryCatalog = projects.filter((project) => !project.has_page);

---

<Section id="work" title="Public projects">
  <div class="featured-column">
    <HorizontalProjectDeck projects={featuredProjects} />

    {caseStudies.length > 0 && (
      <div class="secondary-section">
        <h3 class="secondary-heading">Detailed case studies</h3>
        <div class="secondary-grid">
          {caseStudies.map((p) => (
            <div class="tech-card secondary-card">
              <div class="sec-card-header">
                <h4 class="sec-title">{p.title}</h4>
                <span class="mono-tag">{p.year}</span>
              </div>
              <p class="sec-tagline">{p.tagline}</p>
              {p.headline_metric && (
                <div class="sec-metric">
                  <span class="sec-metric-tag">{p.headline_metric}</span>
                </div>
              )}
              <div class="sec-footer">
                <div class="sec-langs">
                  {p.languages.map((l) => <span class="mono-tag" style="font-size: 10px;">{l}</span>)}
                </div>
                <div class="sec-actions">
                  <a href={p.links.repo} rel="noopener" class="sec-btn">
                    <span class="bracket">[</span>repo<span class="bracket">]</span>
                  </a>
                  <a href={`/projects/${p.slug}/`} class="sec-btn sec-btn-primary">
                    <span class="bracket">[</span>case study &rarr;<span class="bracket">]</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {repositoryCatalog.length > 0 && (
      <div class="catalog-section">
        <h3 class="secondary-heading">More public repositories</h3>
        <p class="catalog-intro">Research code, applications, systems work and coursework with source available on GitHub.</p>
        <div class="catalog-grid">
          {repositoryCatalog.map((p) => (
            <article class="catalog-card">
              <div class="catalog-meta"><span>{p.category}</span><span>{p.year}</span></div>
              <h4><a href={p.links.repo} rel="noopener">{p.title} ↗</a></h4>
              <p>{p.tagline}</p>
              <div class="catalog-tools">{p.languages.map((language) => <span>{language}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
    )}

    <p class="more-repos">
      <a href={`${profile.links.github}?tab=repositories`} rel="noopener" class="term-btn">
        <span class="bracket">[</span>Visit my GitHub profile &rarr;<span class="bracket">]</span>
      </a>
    </p>
  </div>
</Section>

<style>
  .featured-column {
    display: flex;
    flex-direction: column;
    gap: var(--s6);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s5);
  }

  .secondary-section {
    margin-top: var(--s4);
  }
  .catalog-section {
    margin-top: var(--s7);
  }
  .catalog-intro {
    max-width: 42rem;
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--s5);
  }
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s4);
  }
  .catalog-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--s5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }
  .catalog-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--s3);
    color: var(--fg-dim);
    font: 0.68rem var(--font-mono);
    text-transform: uppercase;
  }
  .catalog-card h4 {
    margin: var(--s4) 0 var(--s2);
    font-size: var(--fs-base);
    overflow-wrap: anywhere;
  }
  .catalog-card p {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  .catalog-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: auto;
    padding-top: var(--s3);
  }
  .catalog-tools span {
    color: var(--fg-dim);
    font: 0.68rem var(--font-mono);
  }

  .secondary-heading {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--fg-dim);
    margin-bottom: var(--s4);
    letter-spacing: 0.05em;
  }

  .secondary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s4);
  }

  @media (max-width: 800px) {
    .secondary-grid, .catalog-grid {
      grid-template-columns: 1fr;
    }
  }

  .secondary-card {
    padding: var(--s4);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .sec-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--s2);
  }

  .sec-title {
    font-size: var(--fs-base);
    color: var(--fg);
    margin: 0;
    font-weight: 600;
  }

  .sec-tagline {
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    line-height: var(--lh-body);
    margin-bottom: var(--s3);
  }

  .sec-metric {
    margin-bottom: var(--s3);
  }

  .sec-metric-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-green);
    background: rgba(52, 211, 153, 0.06);
    border: 1px solid rgba(52, 211, 153, 0.2);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    display: inline-block;
  }

  .sec-footer {
    margin-top: auto;
    padding-top: var(--s3);
    border-top: 1px dashed var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }

  .sec-langs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .sec-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sec-btn {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .sec-btn .bracket {
    color: var(--accent);
  }

  .sec-btn-primary {
    color: var(--accent);
  }

  .sec-btn:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  .more-repos {
    margin-top: var(--s2);
    text-align: center;
  }
</style>
